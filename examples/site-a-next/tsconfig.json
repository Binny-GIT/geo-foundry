{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "vitest.config.ts"]
}
