{
  "name": "@geo/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build payload generate:importmap && cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build next build --webpack",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:migrate:create": "node scripts/create-migration.mjs",
    "db:migrate:status": "node scripts/secure-run.mjs payload migrate:status",
    "admin-ui:fixture": "node scripts/secure-run.mjs node --import tsx scripts/admin-ui-fixture.mjs",
    "dev": "node scripts/secure-run.mjs next dev",
    "generate:importmap": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build payload generate:importmap",
    "generate:types": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build payload generate:types",
    "lint": "biome lint --config-path ../../biome.json .",
    "start": "node scripts/secure-run.mjs next start",
    "test": "node --test test/bootstrap-contract.test.mjs && vitest run --configLoader runner test/unit",
    "test:e2e": "node --input-type=module --eval \"\"",
    "test:integration": "node scripts/run-integration.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@geo/compiler": "workspace:*",
    "@geo/domain": "workspace:*",
    "@geo/render-react": "workspace:*",
    "@geo/quality-rules": "workspace:*",
    "@geo/schema": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-multi-tenant": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "bullmq": "6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "7.0.3",
    "graphql": "16.11.0",
    "ioredis": "5.8.2",
    "next": "16.3.0",
    "payload": "3.88.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
