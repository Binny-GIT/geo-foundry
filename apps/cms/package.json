{
  "name": "@geo/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build next build",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:migrate:create": "node scripts/create-migration.mjs",
    "db:migrate:status": "node scripts/secure-run.mjs payload migrate:status",
    "dev": "node scripts/secure-run.mjs next dev",
    "generate:importmap": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build payload generate:importmap",
    "generate:types": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build payload generate:types",
    "lint": "biome lint --config-path ../../biome.json .",
    "start": "node scripts/secure-run.mjs next start",
    "test": "node --test test/bootstrap-contract.test.mjs && vitest run --configLoader runner test/unit",
    "test:e2e": "node --input-type=module --eval \"\"",
    "test:integration": "node scripts/run-integration.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@geo/domain": "workspace:*",
    "@geo/quality-rules": "workspace:*",
    "@geo/schema": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-multi-tenant": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "bullmq": "6.1.2",
    "cross-env": "7.0.3",
    "graphql": "16.11.0",
    "ioredis": "5.8.2",
    "next": "16.3.0",
    "payload": "3.88.0",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
