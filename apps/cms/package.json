{
  "name": "@geo/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cross-env GEO_FOUNDRY_CMS_CONFIG_MODE=build next build --webpack",
    "db:migrate": "node scripts/secure-run.mjs node --import tsx scripts/run-migrations.mjs",
    "db:migrate:status": "node scripts/secure-run.mjs node --import tsx scripts/migration-status.mjs",
    "dev": "node scripts/secure-run.mjs next dev",
    "lint": "biome lint --config-path ../../biome.json .",
    "start": "node scripts/secure-run.mjs next start",
    "test": "node --test test/bootstrap-contract.test.mjs && vitest run --configLoader runner test/unit",
    "test:e2e": "node --input-type=module --eval \"\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "db:migrate:generate": "drizzle-kit generate",
    "password-hash-report": "node scripts/secure-run.mjs node --import tsx scripts/password-hash-report.mjs",
    "pgboss:provision": "node scripts/secure-run.mjs node --import tsx scripts/provision-pgboss.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@geo/compiler": "workspace:*",
    "@geo/domain": "workspace:*",
    "@geo/quality-rules": "workspace:*",
    "@geo/render-react": "workspace:*",
    "@geo/schema": "workspace:*",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "7.0.3",
    "drizzle-orm": "0.45.2",
    "jose": "5.10.0",
    "lucide": "^1.38.0",
    "morphicons": "^1.7.1",
    "next": "16.3.1",
    "pg": "8.20.0",
    "pg-boss": "12.30.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.7",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
