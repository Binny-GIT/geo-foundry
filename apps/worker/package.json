{
  "name": "@geo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "biome lint --config-path ../../biome.json .",
    "start": "node dist/main.js",
    "test": "vitest run --configLoader runner test/unit",
    "test:integration": "node scripts/run-integration.mjs",
    "test:e2e": "node --input-type=module --eval \"\"",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@geo/compiler": "workspace:*",
    "@geo/content-client": "workspace:*",
    "@geo/content-pipeline": "workspace:*",
    "@geo/domain": "workspace:*",
    "@geo/publisher": "workspace:*",
    "@geo/quality-rules": "workspace:*",
    "@geo/schema": "workspace:*",
    "bullmq": "6.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "redis": "5.8.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
