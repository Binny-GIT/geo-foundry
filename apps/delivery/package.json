{
  "name": "@geo/delivery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "biome lint --config-path ../../biome.json .",
    "start": "node dist/main.js",
    "test": "vitest run --configLoader runner test/unit",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@geo/render-core": "workspace:*",
    "@geo/render-react": "workspace:*",
    "@geo/runtime": "workspace:*",
    "@geo/schema": "workspace:*",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
