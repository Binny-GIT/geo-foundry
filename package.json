{
  "name": "geo-foundry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.22.0"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint . && turbo run lint",
    "typecheck": "tsc --noEmit --project tsconfig.base.json && turbo run typecheck",
    "test": "pnpm verify:toolchain && turbo run test",
    "test:fresh": "pnpm verify:toolchain && turbo run test --force --output-logs=full",
    "test:harness": "node scripts/evidence/run.mjs --fresh",
    "test:workspace:fresh": "vitest run --config vitest.workspace.ts --configLoader runner --no-file-parallelism",
    "test:integration": "turbo run test:integration",
    "test:integration:fresh": "turbo run test:integration --force --output-logs=full",
    "test:serving-isolation": "pnpm build && pnpm --filter @geo/runtime test:integration",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "build:fresh": "turbo run build --force --output-logs=full",
    "api:check": "pnpm build && api-extractor run --config packages/schema/api-extractor.json && api-extractor run --config packages/schema/api-extractor.release-v1.json && api-extractor run --config packages/publisher/api-extractor.json && api-extractor run --config packages/publisher/api-extractor.artifact-store.json && api-extractor run --config packages/render-core/api-extractor.json && api-extractor run --config packages/render-react/api-extractor.json",
    "check": "biome format . && pnpm lint && pnpm typecheck && pnpm test && pnpm api:check",
    "dev": "turbo run dev --parallel",
    "packages:pack-smoke:task6:npm": "node tooling/task-6-packed-consumer.mjs npm",
    "packages:pack-smoke:task6:pnpm": "node tooling/task-6-packed-consumer.mjs pnpm",
    "packages:validate": "pnpm build:fresh && node scripts/package-validate.mjs",
    "packages:pack-smoke": "pnpm build:fresh && node scripts/package-smoke.mjs pnpm && node scripts/package-smoke.mjs npm",
    "test:task6:coverage": "pnpm --filter @geo/schema test:release:coverage && pnpm --filter @geo/publisher test:coverage",
    "verify:toolchain": "node --test tooling/toolchain.test.mjs",
    "shared:check": "node scripts/shared-services/secure-run.mjs check",
    "shared:cleanup": "node scripts/shared-services/secure-run.mjs cleanup",
    "evidence:verify": "node scripts/evidence/verify.mjs",
    "mvp:seed": "cd apps/cms && node scripts/secure-run.mjs node scripts/mvp-seed.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@microsoft/api-extractor": "7.58.12",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "fast-check": "4.9.0",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "pg": "8.16.3",
    "redis": "5.8.2",
    "zod": "4.1.12"
  }
}
