IMAGE_TAG=mk-dev-verify
COMPOSE_ENV=verify
GEO_FOUNDRY_PG_HOST=127.0.0.1
GEO_FOUNDRY_S3_ENDPOINT=127.0.0.1
GEO_FOUNDRY_REDIS_HOST=127.0.0.1
GEO_FOUNDRY_REDIS_PORT=6379
# `make container-smoke` creates a uid 1001, mode 0700 temporary directory
# and supplies GEO_FOUNDRY_CREDENTIALS_DIR only for the Compose invocation.
