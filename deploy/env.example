# Geo Foundry CMS — environment variables
# 仅变量名与非敏感示例值。真实值保存在 /opt/geo-foundry/mk-dev.env（mode 600），
# 由部署命令通过 --env-file 注入，凭据不得进入仓库或镜像。

# 镜像版本（mk-dev 使用 mk-dev-<git-sha> 标签，禁止 latest）
IMAGE_TAG=mk-dev-0000000

# Compose 环境（verify / mk-dev）
COMPOSE_ENV=mk-dev

# Owner-only credential directory. It must be uid 1001, mode 0700; every file
# inside must be uid 1001, mode 0600. Compose binds it read-only into containers.
GEO_FOUNDRY_CREDENTIALS_DIR=/opt/geo-foundry/credentials

# PostgreSQL（共享 pg-server；容器内经 pg_default 网络访问）
GEO_FOUNDRY_PG_HOST=pg-server
GEO_FOUNDRY_PG_PORT=5432

# Redis（共享服务；mk-dev 覆盖层通过 host.docker.internal 访问）
GEO_FOUNDRY_REDIS_HOST=127.0.0.1
GEO_FOUNDRY_REDIS_PORT=6379
GEO_FOUNDRY_REDIS_DATABASE=0

# RustFS（共享 rustfs-server；容器内经 rustfs-shared 网络访问）
GEO_FOUNDRY_S3_ENDPOINT=rustfs-server
GEO_FOUNDRY_S3_PORT=9000

# Worker provider selection. The default fake provider does not read ai-api-key.
AI_PROVIDER=fake

# Credential file names under GEO_FOUNDRY_CREDENTIALS_DIR:
# pg-user, pg-password, redis-password, s3-access-key, s3-secret-key,
# cms-secret, content-service-keyring.json, and optionally ai-api-key.
# Never place credential values in this file.
