NODE_ENV=development
LOG_LEVEL=debug
GEO_FOUNDRY_PG_HOST=pg-server
GEO_FOUNDRY_PG_PORT=5432
GEO_FOUNDRY_PG_BOOTSTRAP_DATABASE=postgres
GEO_FOUNDRY_PG_DATABASE=geo_foundry
GEO_FOUNDRY_PG_SCHEMA=geo_foundry
GEO_FOUNDRY_PG_USER_FILE=
GEO_FOUNDRY_PG_PASSWORD_FILE=
GEO_FOUNDRY_REDIS_HOST=redis-server
GEO_FOUNDRY_REDIS_PORT=6379
GEO_FOUNDRY_REDIS_DATABASE=0
GEO_FOUNDRY_REDIS_PASSWORD_FILE=
GEO_FOUNDRY_REDIS_USERNAME_FILE=
GEO_FOUNDRY_S3_ENDPOINT=127.0.0.1
GEO_FOUNDRY_S3_PORT=9000
GEO_FOUNDRY_S3_USE_SSL=false
GEO_FOUNDRY_S3_FORCE_PATH_STYLE=true
GEO_FOUNDRY_S3_SECRET_REF=rustfs-geo-foundry-svc
GEO_FOUNDRY_S3_ACCESS_KEY_FILE=
GEO_FOUNDRY_S3_SECRET_KEY_FILE=
GEO_FOUNDRY_CMS_SECRET_FILE=

# Host-local launcher: /home/ubuntu/.local/bin/geo-foundry-cms-secure
# PostgreSQL secret ref: pg-server-mk-dev-existing-auth (POSTGRES_USER, POSTGRES_PASSWORD)
# RustFS secret ref: rustfs-geo-foundry-svc (service access key, service secret key)
# Redis username/password are optional and must use the same secure process-only injection when set.
# All *_FILE values must refer to owner-only credential files. Never place credential values here.
