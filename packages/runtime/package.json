{
  "name": "@geo/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "biome lint --config-path ../../biome.json .",
    "test": "vitest run --configLoader runner",
    "test:integration": "node scripts/run-serving-isolation.mjs",
    "test:e2e": "node --input-type=module --eval \"\"",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@geo/schema": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@geo/compiler": "workspace:*",
    "@geo/publisher": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
