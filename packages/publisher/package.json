{
  "name": "@geo/publisher",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifact-store": {
      "types": "./dist/artifact-store.d.ts",
      "import": "./dist/artifact-store.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "biome lint --config-path ../../biome.json .",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@geo/compiler": "workspace:*",
    "@geo/schema": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
