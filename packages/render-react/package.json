{
  "name": "@geo/render-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "biome lint --config-path ../../biome.json .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --input-type=module --eval \"\"",
    "test:e2e": "node --input-type=module --eval \"\"",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@geo/render-core": "workspace:*",
    "@geo/schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.11.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
